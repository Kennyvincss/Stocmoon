BASE_MAINNET_RPC_URL=https://mainnet.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# operator wallet: keeper (opens/settles markets) + relayer (mirrors mainnet Chainlink rounds)
KEEPER_ADDRESS=0x25AA8d4dd7Fc624b19665B14AA2d179a443C059f
RELAYER_ADDRESS=0x25AA8d4dd7Fc624b19665B14AA2d179a443C059f
TOKEN_URI=https://stocmoon.vercel.app/api/tokens/{id}
ENABLE_INTRADAY_DURATIONS=false
ENABLE_SHORT_DURATIONS=false
