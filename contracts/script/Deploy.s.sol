pragma solidity 0.8.28;

import {Script, console2} from "forge-std/Script.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {StocMoonMarkets} from "../src/StocMoonMarkets.sol";
import {StocMoonLens} from "../src/StocMoonLens.sol";
import {OracleAdapter} from "../src/OracleAdapter.sol";
import {MirrorAggregator} from "../src/MirrorAggregator.sol";

/// @notice Deploys StocMoon.
///   Base Sepolia (84532): deploys one MirrorAggregator per asset (mirrors Base mainnet Chainlink feed).
///   Base mainnet (8453):  registers the Chainlink proxies directly.
///
/// Inputs
///   config/assets.json          generated by `pnpm assets:sync` (verified API + onchain feed data)
///   env USDC_ADDRESS            collateral (Circle USDC)
///   env KEEPER_ADDRESS          MARKET_CREATOR + RESOLVER (events) role
///   env RELAYER_ADDRESS         testnet mirror relayer
///   env ELIGIBILITY_ADDRESS     eligibility signer (optional)
///   env TOKEN_URI               ERC-1155 metadata URI template
///   env ENABLE_SHORT_DURATIONS  "true" to enable 5m/15m/30m (only if feed update frequency supports it)
///
/// Run: forge script script/Deploy.s.sol --rpc-url base_sepolia --account <keystore> --broadcast --verify
contract Deploy is Script {
    struct AssetEntry {
        uint8 decimals;
        address feed;
        uint256 maxStaleness;
        string symbol;
        address token;
    }

    function run() external {
        string memory json = vm.readFile(string.concat(vm.projectRoot(), "/config/assets.json"));
        AssetEntry[] memory assets = abi.decode(vm.parseJson(json, ".assets"), (AssetEntry[]));
        require(assets.length > 0, "no assets: run pnpm assets:sync");

        address usdc = vm.envAddress("USDC_ADDRESS");
        address keeper = vm.envAddress("KEEPER_ADDRESS");
        address relayer = vm.envOr("RELAYER_ADDRESS", keeper);
        address eligibility = vm.envOr("ELIGIBILITY_ADDRESS", address(0));
        string memory uri = vm.envOr("TOKEN_URI", string("https://stocmoon.app/api/tokens/{id}"));
        bool shortDurations = vm.envOr("ENABLE_SHORT_DURATIONS", false);
        bool testnet = block.chainid == 84532 || block.chainid == 31337;
        require(testnet || block.chainid == 8453, "unsupported chain");

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();

        OracleAdapter oracle = new OracleAdapter(deployer);
        StocMoonMarkets markets = new StocMoonMarkets(IERC20(usdc), oracle, deployer, uri);
        StocMoonLens lens = new StocMoonLens(markets);

        string memory feedsJson = "feeds";
        for (uint256 i; i < assets.length; ++i) {
            AssetEntry memory a = assets[i];
            require(a.token != address(0) && a.feed != address(0), "asset missing token/feed");
            address feed = a.feed;
            if (testnet) {
                feed = address(
                    new MirrorAggregator(deployer, relayer, a.decimals, string.concat(a.symbol, " / USD"), 8453, a.feed)
                );
            }
            oracle.configureAsset(a.token, feed, uint32(a.maxStaleness), a.symbol);
            vm.serializeAddress(feedsJson, a.symbol, feed);
        }

        // Chainlink Coinbase feeds update on 0.5% deviation or a 24h heartbeat, so intraday markets would often
        // settle on the opening round (push). Intraday durations are opt-in.
        bool intraday = vm.envOr("ENABLE_INTRADAY_DURATIONS", false);
        markets.setDuration(1 hours, intraday, 5 minutes);
        markets.setDuration(4 hours, intraday, 15 minutes);
        markets.setDuration(1 days, true, 30 minutes);
        markets.setDuration(7 days, true, 2 hours);
        markets.setDuration(30 days, true, 1 days);
        markets.setDuration(5 minutes, shortDurations, 1 minutes);
        markets.setDuration(15 minutes, shortDurations, 2 minutes);
        markets.setDuration(30 minutes, shortDurations, 3 minutes);

        markets.grantRole(markets.MARKET_CREATOR_ROLE(), keeper);
        markets.grantRole(markets.RESOLVER_ROLE(), keeper);
        if (eligibility != address(0)) markets.grantRole(markets.ELIGIBILITY_ROLE(), eligibility);
        vm.stopBroadcast();

        string memory feedsOut = vm.serializeString(feedsJson, "_", "");
        string memory root = "deployment";
        vm.serializeUint(root, "chainId", block.chainid);
        vm.serializeAddress(root, "usdc", usdc);
        vm.serializeAddress(root, "oracleAdapter", address(oracle));
        vm.serializeAddress(root, "markets", address(markets));
        vm.serializeAddress(root, "lens", address(lens));
        vm.serializeUint(root, "deployBlock", block.number);
        string memory out = vm.serializeString(root, "feeds", feedsOut);
        vm.writeJson(out, string.concat(vm.projectRoot(), "/deployments/", vm.toString(block.chainid), ".json"));

        console2.log("OracleAdapter  ", address(oracle));
        console2.log("StocMoonMarkets", address(markets));
        console2.log("StocMoonLens   ", address(lens));
    }
}
