CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://mainnet.base.org       # source of real Chainlink rounds (relayer, assets:sync)
DATABASE_URL=postgres://user:pass@host:5432/stocmoon
# Contract addresses default to contracts/deployments/<CHAIN_ID>.json
# MARKETS_ADDRESS= LENS_ADDRESS= ORACLE_ADDRESS= USDC_ADDRESS= DEPLOY_BLOCK=

# Keys: use dedicated low-privilege hot wallets. Never reuse the deployer/admin key.
KEEPER_PRIVATE_KEY=        # MARKET_CREATOR_ROLE (+ RESOLVER_ROLE); funded with test USDC for seed liquidity
RELAYER_PRIVATE_KEY=       # RELAYER_ROLE on each MirrorAggregator (testnet only)

KEEPER_DURATIONS=3600,14400,86400
KEEPER_LIQUIDITY=50000000            # 50 USDC per new market
KEEPER_BATTLES=                      # tokenA:tokenB:seconds,...
KEEPER_ASSETS=                       # optional allowlist of token addresses
RELAYER_INTERVAL_MS=20000
INDEXER_CONFIRMATIONS=3
INDEXER_BLOCK_CHUNK=2000
SNAPSHOT_INTERVAL_MS=300000
