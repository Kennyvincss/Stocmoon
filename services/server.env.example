# StocMoon bot settings for an always-on server. Keep this file private (chmod 600). Never commit it.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://mainnet.base.org

# Operator wallet (0x25AA...). The 0x prefix is optional.
OPERATOR_PRIVATE_KEY=

# Free Alpaca paper account -> API Keys (live prices for 5m-1H markets)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=

# 24H / 7D markets (Chainlink-settled): which stocks, durations and seed liquidity
KEEPER_ASSETS=0xb20000000000000000000078ee7ce2fE4908108C,0xb2000000000000000000001e800a7f5189430cD0
KEEPER_DURATIONS=86400,604800
KEEPER_LIQUIDITY=10000000
# Stock Battles (tokenA:tokenB:seconds): NVDA vs TSLA over 24H and 7D
KEEPER_BATTLES=0xb20000000000000000000078ee7ce2fE4908108C:0xb2000000000000000000001e800a7f5189430cD0:86400,0xb20000000000000000000078ee7ce2fE4908108C:0xb2000000000000000000001e800a7f5189430cD0:604800

# 5m-1H markets: extended hours (04:00-20:00 ET), 5 USDC seed each, only for stocks trading on IEX
INTRADAY_HOURS=extended
INTRADAY_DURATIONS=300,900,3600
INTRADAY_LIQUIDITY=5000000
