# ---- public (inlined into the browser bundle at build time; NEVER put secrets here)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_MARKETS_ADDRESS=
NEXT_PUBLIC_LENS_ADDRESS=
NEXT_PUBLIC_ORACLE_ADDRESS=
# Circle test USDC on Base Sepolia (default when unset)
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- server only
RPC_URL=                      # private Base Sepolia RPC (falls back to NEXT_PUBLIC_RPC_URL)
MAINNET_RPC_URL=https://mainnet.base.org   # read-only Chainlink history
DATABASE_URL=                 # postgres://... (Supabase works); optional but needed for history/leaderboard/profiles
DEPLOY_BLOCK=0                # markets contract deployment block (log scans)
BLOCKED_COUNTRIES=US,CU,IR,KP,SY
ALLOW_UNKNOWN_COUNTRY=false   # dev only: true lets requests without CDN geo headers trade
ELIGIBILITY_SIGNER_PRIVATE_KEY=   # optional; holds ELIGIBILITY_ROLE when onchain eligibility is enforced
IP_HASH_SALT=change-me
# TOKENIZED_STOCKS_API_URL=   # override only for local testing; defaults to https://api.coinbase.com/v1/tokenized-stocks
# Live second-by-second chart prices (display only, never settlement). Pyth Hermes requires an API key since Aug 2026.
PYTH_API_KEY=
# PYTH_HERMES_URL=https://hermes.pyth.network
